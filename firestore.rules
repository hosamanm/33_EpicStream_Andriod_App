rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin via Custom Claims
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Helper to check if user is the owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      
      // User Library Sub-collections
      match /watchlist/{movieId} {
        allow read, write: if isOwner(userId);
      }
      match /favorites/{movieId} {
        allow read, write: if isOwner(userId);
      }
      match /continue_watching/{movieId} {
        allow read, write: if isOwner(userId);
      }
      match /watch_history/{movieId} {
        allow read, write: if isOwner(userId);
      }
      match /tokens/{token} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- Content (Movies, Genres, Categories) ---
    match /movies/{movieId} {
      allow read: if true; 
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /genres/{genreId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /languages/{langId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /countries/{countryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /age_ratings/{ratingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /home_sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notification_history/{historyId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin(); 
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }
    match /user_notification_settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // --- System & Analytics ---
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }
    match /analytics/{doc=**} {
      allow read, write: if isAdmin();
    }
    
    // Explicit deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
